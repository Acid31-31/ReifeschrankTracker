<Window x:Class="ReifeschrankTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:ReifeschrankTracker.ViewModels"
        Title="Reifeschrank Tracker" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#F1F1F1">
    <Window.Resources>
        <Style x:Key="KPI" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="KPILabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="KPIValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="160"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Charge-Liste -->
        <DockPanel Grid.Column="0" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="Chargen" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
                <Button Content="+ Neue Charge" Command="{Binding NeuChargeBefehl}" Margin="0,2"/>
                <Button Content="Gewicht eintragen" Command="{Binding GewichtEintragenBefehl}" Margin="0,2"/>
                <Button Content="Charge löschen" Command="{Binding ChargeLoeschenBefehl}" Margin="0,2"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Chargen}"
                     SelectedItem="{Binding AusgewählteCharge}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding WarnBadge}" FontSize="11"
                                           Visibility="{Binding WarnBadge, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <!-- Right: Detail -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" DataContext="{Binding Detail}">
                <TextBlock Text="Bitte eine Charge auswählen." FontStyle="Italic" Foreground="Gray"
                           Visibility="{Binding DataContext.HatAuswahl, RelativeSource={RelativeSource AncestorType=Window},
                                        Converter={StaticResource BoolToVisibilityInverse}}"/>

                <!-- Detail content, shown when a charge is selected -->
                <StackPanel Visibility="{Binding DataContext.HatAuswahl, RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}">
                    <!-- Header -->
                    <TextBlock FontSize="20" FontWeight="Bold" TextWrapping="Wrap">
                        <Run Text="{Binding Produktname, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding ChargeCode, Mode=OneWay}" Foreground="Gray"/>
                    </TextBlock>

                    <!-- Warnbadge -->
                    <Border Background="#3D2B00" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,4,0,4"
                            Visibility="{Binding HatWarnung, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding WarnBadge}" FontWeight="Bold"/>
                    </Border>

                    <!-- Kennzahlen -->
                    <UniformGrid Columns="3" Margin="0,8,0,8">
                        <Border Style="{StaticResource KPI}">
                            <StackPanel>
                                <TextBlock Text="Startgewicht" Style="{StaticResource KPILabel}"/>
                                <TextBlock Style="{StaticResource KPIValue}">
                                    <Run Text="{Binding StartgewichtG, Mode=OneWay}"/><Run Text=" g"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KPI}">
                            <StackPanel>
                                <TextBlock Text="Letztes Gewicht" Style="{StaticResource KPILabel}"/>
                                <TextBlock Style="{StaticResource KPIValue}">
                                    <Run Text="{Binding LetztesGewichtG, Mode=OneWay, TargetNullValue='–'}"/><Run Text=" g"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KPI}">
                            <StackPanel>
                                <TextBlock Text="Verlust" Style="{StaticResource KPILabel}"/>
                                <TextBlock Style="{StaticResource KPIValue}">
                                    <Run Text="{Binding VerlustG, Mode=OneWay}"/><Run Text=" g  ("/>
                                    <Run Text="{Binding VerlustProzent, Mode=OneWay}"/><Run Text=" %)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KPI}">
                            <StackPanel>
                                <TextBlock Text="Tage seit Start" Style="{StaticResource KPILabel}"/>
                                <TextBlock Text="{Binding TageSeitStart, Mode=OneWay}" Style="{StaticResource KPIValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KPI}">
                            <StackPanel>
                                <TextBlock Text="Status" Style="{StaticResource KPILabel}"/>
                                <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource KPIValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KPI}">
                            <StackPanel>
                                <TextBlock Text="Ziel" Style="{StaticResource KPILabel}"/>
                                <TextBlock Text="{Binding ZielAnzeige, Mode=OneWay}" Style="{StaticResource KPIValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Diagramm -->
                    <TextBlock Text="Gewicht über Zeit" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <lvc:CartesianChart Series="{Binding DiagrammReihen}"
                                       XAxes="{Binding XAchsen}"
                                       Height="220"/>

                    <!-- Messungen -->
                    <TextBlock Text="Messungen" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <DataGrid ItemsSource="{Binding Messungen}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum/Uhrzeit" Binding="{Binding Zeitpunkt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="Gewicht (g)" Binding="{Binding GewichtG}" Width="100"/>
                            <DataGridTextColumn Header="Verlust (g)" Binding="{Binding VerlustG}" Width="90"/>
                            <DataGridTextColumn Header="Verlust (%)" Binding="{Binding VerlustProzent}" Width="90"/>
                            <DataGridTextColumn Header="Notiz" Binding="{Binding Notiz}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Notizen -->
                    <TextBlock Text="Notizen" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"
                               Visibility="{Binding Notizen, Converter={StaticResource StringToVisibility}}"/>
                    <TextBlock Text="{Binding Notizen}" TextWrapping="Wrap"
                               Visibility="{Binding Notizen, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
