<Application x:Class="ReifeschrankTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ReifeschrankTracker.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- ── Dark Theme Palette ─────────────────────────────────────────── -->
        <SolidColorBrush x:Key="Dark.Bg"          Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Dark.Surface"     Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Surface2"    Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Border"      Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Fg"          Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Fg.Muted"    Color="#999999"/>
        <SolidColorBrush x:Key="Dark.Accent"      Color="#0E639C"/>
        <SolidColorBrush x:Key="Dark.AccentHover" Color="#1177BB"/>
        <SolidColorBrush x:Key="Dark.Selection"   Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Highlight"   Color="#094771"/>

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Fg}"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"     Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"     Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush"     Value="{StaticResource Dark.Fg}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Selection}"/>
            <Setter Property="Padding"        Value="4,3"/>
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"  Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"  Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Fg}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Highlight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="Background"  Value="{StaticResource Dark.Surface}"/>
            <Setter Property="Foreground"  Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Fg}"/>
            <Setter Property="Padding"    Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Selection}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Highlight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GridSplitter -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Dark.Border}"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource Dark.Surface}"/>
            <Setter Property="Foreground"               Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Dark.Border}"/>
            <Setter Property="RowBackground"            Value="{StaticResource Dark.Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource Dark.Border}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"  Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Fg}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Selection}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Highlight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground"  Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="{StaticResource Dark.Selection}"/>
                    <Setter Property="Foreground"  Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Dark.Selection}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ScrollBar – slim dark scrollbar, no arrow buttons -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource Dark.Surface}"/>
            <Setter Property="Width"      Value="10"/>
            <Setter Property="MinWidth"   Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource Dark.Border}"
                                                        CornerRadius="4" Margin="2,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height"    Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          Background="Transparent" BorderThickness="0"
                                                          Focusable="False" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{StaticResource Dark.Border}"
                                                                CornerRadius="4" Margin="1,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          Background="Transparent" BorderThickness="0"
                                                          Focusable="False" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ToolTip -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"  Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"  Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Padding"     Value="6,4"/>
        </Style>

        <!-- ── Dark Calendar Palette ───────────────────────────────────── -->
        <SolidColorBrush x:Key="Cal.Bg"          Color="#252526"/>
        <SolidColorBrush x:Key="Cal.Border"      Color="#3F3F46"/>
        <SolidColorBrush x:Key="Cal.Fg"          Color="#ECECEC"/>
        <SolidColorBrush x:Key="Cal.Fg.Muted"    Color="#888888"/>
        <SolidColorBrush x:Key="Cal.Accent"      Color="#0E639C"/>
        <SolidColorBrush x:Key="Cal.AccentHover" Color="#1177BB"/>
        <SolidColorBrush x:Key="Cal.Today"       Color="#264F78"/>

        <!-- DatePicker – full ControlTemplate so the popup gets a dark background -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background"     Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"     Value="{StaticResource Dark.Fg}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Selection}"/>
            <Setter Property="CaretBrush"     Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background"      Value="{StaticResource Dark.Surface2}"/>
            <Setter Property="Foreground"      Value="{StaticResource Dark.Fg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"/>

                                <!-- Calendar-icon toggle button -->
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{TemplateBinding Foreground}"
                                        Padding="6,0"
                                        Cursor="Hand"
                                        VerticalAlignment="Stretch">
                                    <Path Data="M3,1 L3,0 M7,1 L7,0 M0,3 L10,3 M0,1 L0,9 L10,9 L10,1 Z
                                                M2,5 L4,5 M2,7 L4,7 M5,5 L7,5 M5,7 L7,7 M8,5 L10,5"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1"
                                          Width="10" Height="9"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Button>

                                <!-- Popup – Border here is what was white before -->
                                <Popup x:Name="PART_Popup"
                                       Grid.Column="0"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False">
                                    <Border Background="{StaticResource Cal.Bg}"
                                            BorderBrush="{StaticResource Cal.Border}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Padding="1">
                                        <!-- Force dark colors directly on the Calendar instance,
                                             in addition to the implicit Calendar style above -->
                                        <Calendar x:Name="PART_Calendar"
                                                  Background="#252526"
                                                  Foreground="#ECECEC"
                                                  BorderBrush="#3F3F46"
                                                  BorderThickness="0"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CalendarDayButton – individual day cells ──────────────────── -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="MinWidth"  Value="5"/>
            <Setter Property="MinHeight" Value="5"/>
            <Setter Property="FontSize"  Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Cal.Fg}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Margin="1"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="4,2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cal.Today}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cal.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cal.AccentHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Cal.Fg.Muted}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CalendarButton – month/year cells in year/decade view ──────── -->
        <Style TargetType="CalendarButton">
            <Setter Property="MinWidth"  Value="40"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize"  Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Cal.Fg}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Cal.AccentHover}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Cal.Accent}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected"/>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Cal.Accent}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ActiveStates">
                                    <VisualState x:Name="Active"/>
                                    <VisualState x:Name="Inactive"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                    <VisualState x:Name="CalendarButtonUnfocused"/>
                                    <VisualState x:Name="CalendarButtonFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Margin="1"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="4,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CalendarItem – main calendar frame ─────────────────────────── -->
        <Style TargetType="CalendarItem">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <ControlTemplate.Resources>
                            <!-- Day-of-week header row (Mon, Tue …) -->
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Cal.Fg.Muted}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Margin="0,3"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>

                        <Border Background="{StaticResource Cal.Bg}"
                                BorderBrush="{StaticResource Cal.Border}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Grid x:Name="PART_Root">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Navigation: ◄  March 2026  ► -->
                                <Grid Grid.Row="0" Margin="4,6,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PART_PreviousButton"
                                            Grid.Column="0"
                                            Width="28" Height="24"
                                            Padding="0"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource Cal.Fg}"
                                            FontSize="11"
                                            Content="◄"
                                            Cursor="Hand"/>

                                    <Button x:Name="PART_HeaderButton"
                                            Grid.Column="1"
                                            Padding="4,0"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource Cal.Fg}"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand"/>

                                    <Button x:Name="PART_NextButton"
                                            Grid.Column="2"
                                            Width="28" Height="24"
                                            Padding="0"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource Cal.Fg}"
                                            FontSize="11"
                                            Content="►"
                                            Cursor="Hand"/>
                                </Grid>

                                <!-- Separator -->
                                <Rectangle Grid.Row="1" Height="1"
                                           Fill="{StaticResource Cal.Border}"
                                           Margin="4,0,4,2"/>

                                <!-- Month view (day names + day cells: 7×7) -->
                                <Grid x:Name="PART_MonthView"
                                      Grid.Row="2"
                                      Visibility="Visible"
                                      Margin="4,0,4,4"/>

                                <!-- Year view (month cells: 4×3) -->
                                <Grid x:Name="PART_YearView"
                                      Grid.Row="2"
                                      Visibility="Hidden"
                                      Margin="4,0,4,4"/>

                                <!-- Disabled overlay -->
                                <Rectangle x:Name="PART_DisabledVisual"
                                           Grid.RowSpan="3"
                                           Fill="#88000000"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calendar wrapper – full ControlTemplate to override white Aero2 default ── -->
        <Style TargetType="Calendar">
            <Setter Property="Background"      Value="{StaticResource Cal.Bg}"/>
            <Setter Property="Foreground"      Value="{StaticResource Cal.Fg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Cal.Border}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <!-- Bypass the Aero2 default entirely; render CalendarItem directly -->
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{StaticResource Cal.Bg}"
                                      BorderBrush="{StaticResource Cal.Border}"
                                      BorderThickness="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
