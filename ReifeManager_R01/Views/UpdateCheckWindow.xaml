<Window x:Class="ReifeManager_R01.Views.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update-Prüfung" Height="560" Width="900" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#F3F3F3" ResizeMode="NoResize">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            
            <TextBlock Text="📦 Update-Status" FontSize="32" FontWeight="Bold" Foreground="#6EB7FF" Margin="0,0,0,24" />
            
            <Border Background="#2A2A2A" CornerRadius="8" Padding="24" BorderBrush="#555555" BorderThickness="2" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Aktuelle Version:" Width="280" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="{Binding CurrentVersion}" Foreground="#FFD54F" FontSize="18" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Verfügbar:" Width="280" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="{Binding AvailableVersion}" Foreground="#6EB7FF" FontSize="18" />
                    </StackPanel>
                    
                    <Separator Background="#444444" Margin="0,16,0,16" Height="2"/>
                    
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="16" LineHeight="28" />
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🌐 GitHub öffnen" Click="OnGitHubClick" 
                        Background="#3A3A3A" Foreground="#F3F3F3" Padding="24,16" Cursor="Hand" Margin="0,0,16,0" FontSize="16" />
                <Button Content="✓ Schließen" Click="OnCloseClick" 
                        Background="#3A3A3A" Foreground="#F3F3F3" Padding="24,16" Cursor="Hand" FontSize="16" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
