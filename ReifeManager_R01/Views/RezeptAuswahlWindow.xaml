<Window x:Class="ReifeManager_R01.Views.RezeptAuswahlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🍖 Rezept auswählen" Height="600" Width="900"
        Background="#1E1E1E" Foreground="#F3F3F3"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📋 Chargeninformationen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#6EB7FF" />

        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bezeichnung:" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="ChargeBezeichnung" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Fleischtyp:" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="ChargeFleischtyp" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Profil:" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="ChargeProfil" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RezeptListe">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A" CornerRadius="6" Padding="16" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="Rezept_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#6EB7FF" />
                                <TextBlock Grid.Row="1" Text="{Binding Beschreibung}" FontSize="13" Opacity="0.85" Margin="0,4,0,8" TextWrapping="Wrap" />

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Pökeln:" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding PoekelnTage, StringFormat='{}{0} Tage'}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Abbrennen:" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding AbbrennenTage, StringFormat='{}{0} Tage'}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Räuchern:" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding RaeuchernTage, StringFormat='{}{0} Tage'}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Reifen:" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="{Binding ReifenTage, StringFormat='{}{0} Tage'}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="4" Padding="8">
                                    <TextBlock Text="👆 Klicken zum Auswählen" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="❌ Überspringen" Width="140" Height="36" Background="#DD3333" Foreground="#FFFFFF" Click="Abbrechen_Click" />
        </StackPanel>
    </Grid>
</Window>
