<Window x:Class="ReifeManager_R01.Views.StueckDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fleischstück bearbeiten" Height="550" Width="750"
        Background="#1E1E1E" Foreground="#F3F3F3" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Fleischstück &amp; Charge ändern" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
            
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Stück-ID:" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="IdBox" IsReadOnly="True" Height="32" Margin="0,0,0,15" Opacity="0.6" />
                    
                    <TextBlock Text="Startgewicht (g):" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="StartgewichtBox" Height="32" Margin="0,0,0,15" FontSize="14" />
                    
                    <TextBlock Text="Aktuelles Gewicht (g):" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="AktuellesBox" IsReadOnly="True" Height="32" Margin="0,0,0,15" Opacity="0.6" />
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Gewichtsverlust (%):" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="VerlustBox" IsReadOnly="True" Height="32" Margin="0,0,0,15" Opacity="0.6" />
                    
                    <TextBlock Text="Reifetage:" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="ReifetageBox" IsReadOnly="True" Height="32" Margin="0,0,0,15" Opacity="0.6" />
                    
                    <TextBlock Text="Status:" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="StatusBox" IsReadOnly="True" Height="32" Margin="0,0,0,15" Opacity="0.6" />
                </StackPanel>
            </Grid>
            
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Charge Startdatum:" FontSize="12" Margin="0,0,0,5" Foreground="#FFD54F" FontWeight="SemiBold" />
                    <DatePicker x:Name="StartdatumPicker" Height="32" Margin="0,0,0,0" SelectedDateFormat="Short" />
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Messungen:" FontSize="12" Margin="0,0,0,5" />
                    <TextBox x:Name="MessungenBox" IsReadOnly="True" Height="32" Margin="0,0,0,0" Opacity="0.6" />
                </StackPanel>
            </Grid>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="✓ Speichern" Height="36" Padding="24,0" Background="#0A84FF" Click="Speichern_Click" FontSize="13" />
                <Button Content="✗ Abbrechen" Height="36" Padding="24,0" Margin="12,0,0,0" Background="#666666" Click="Abbrechen_Click" FontSize="13" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
