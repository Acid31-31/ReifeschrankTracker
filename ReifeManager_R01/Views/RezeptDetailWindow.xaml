<Window x:Class="ReifeManager_R01.Views.RezeptDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 Rezept-Details" Height="700" Width="800"
        Background="#1E1E1E" Foreground="#F3F3F3"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="RezeptName" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#6EB7FF" />

        <ScrollViewer Grid.Row="1" x:Name="DruckBereich" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Padding="20">
            <StackPanel>
                <TextBlock x:Name="DruckRezeptName" FontSize="22" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,10" />
                <TextBlock x:Name="DruckBeschreibung" FontSize="14" Foreground="#333333" TextWrapping="Wrap" Margin="0,0,0,20" />

                <Border Background="#F0F0F0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pökeln" FontSize="12" Foreground="#666666" />
                            <TextBlock x:Name="DruckPoekeln" FontSize="16" FontWeight="SemiBold" Foreground="#000000" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Abbrennen" FontSize="12" Foreground="#666666" />
                            <TextBlock x:Name="DruckAbbrennen" FontSize="16" FontWeight="SemiBold" Foreground="#000000" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Räuchern" FontSize="12" Foreground="#666666" />
                            <TextBlock x:Name="DruckRaeuchern" FontSize="16" FontWeight="SemiBold" Foreground="#000000" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Reifen" FontSize="12" Foreground="#666666" />
                            <TextBlock x:Name="DruckReifen" FontSize="16" FontWeight="SemiBold" Foreground="#000000" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="🧂 Zutaten" FontSize="18" FontWeight="SemiBold" Foreground="#000000" Margin="0,0,0,8" />
                <TextBlock x:Name="DruckZutaten" FontSize="13" Foreground="#333333" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="📋 Anleitung" FontSize="18" FontWeight="SemiBold" Foreground="#000000" Margin="0,0,0,8" />
                <TextBlock x:Name="DruckAnleitung" FontSize="13" Foreground="#333333" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="🖨️ Drucken" Width="120" Height="36" Background="#0A84FF" Foreground="#FFFFFF" Click="Drucken_Click" Margin="0,0,8,0" />
            <Button Content="❌ Schließen" Width="120" Height="36" Background="#DD3333" Foreground="#FFFFFF" Click="Schliessen_Click" />
        </StackPanel>
    </Grid>
</Window>
